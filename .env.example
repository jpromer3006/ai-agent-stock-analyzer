# =============================================================================
# OROS - Agentic Finance System - environment template
# =============================================================================
# Copy to .env and fill in values.  .env is gitignored and must NEVER be
# committed, screenshotted, or pasted into a chat.  If a key is ever exposed,
# rotate it immediately at the provider, then run:
#
#     PYTHONPATH=. python3 scripts/check_keys.py
#
# Preferred storage for ANTHROPIC_API_KEY is the Mac Keychain, not this file:
#     security add-generic-password -a "$USER" -s "ANTHROPIC_API_KEY" -w "sk-ant-..."
# The app and the health check read Keychain first, then .env as fallback.
# =============================================================================

# --- REQUIRED ---------------------------------------------------------------

# Anthropic. Powers the classifier, the screen tier (Haiku), and the memo
# tier (Sonnet).  Keychain first, this value is the fallback.
ANTHROPIC_API_KEY=

# FRED (St. Louis Fed).  Macro context: rates, inflation, yield curve.
# Free, generous limits.  https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Alpha Vantage.  Earnings calendar and news sentiment fallback.
# FREE TIER IS 25 REQ/DAY, 5/MIN.  Used sparingly and cached.  A premium key
# raises limits if mid-cap earnings coverage becomes a bottleneck.
ALPHA_VANTAGE_API_KEY=

# --- OPTIONAL ---------------------------------------------------------------

# Financial Modeling Prep.  Largely retired in favor of SEC XBRL + Alpha
# Vantage.  Leave blank unless a specific fundamentals endpoint is re-enabled.
FMP_API_KEY=

# ElevenLabs.  Text to speech for the audio pre-market brief only.  Optional.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Google Earth Engine service account (alt-data, geospatial).  Path to JSON.
GEE_SERVICE_ACCOUNT_KEY_PATH=

# --- PHONE NOTIFICATIONS (email -> phone, hands-off) ------------------------
# The unattended runner emails you on portfolio changes and fresh opportunities.
# Use a Google App Password (Google Account > Security > 2-Step Verification >
# App passwords), NOT your normal login password. One-time setup.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_TO=          # optional; defaults to GMAIL_ADDRESS

# --- PLANNED (full-universe build, free stack) ------------------------------
# No paid market-data key is required for the free path.  These are placeholders
# so the bulk-data layer can be flipped to a paid provider later without code
# changes.  Leave blank to use yfinance + SEC/exchange symbol files.
#
# SEC requires a descriptive User-Agent on every request (10 req/sec max):
SEC_USER_AGENT=OROS Research admin@adminaillc.com
#
# Optional paid fallbacks for the 8,000-name scan if yfinance throttles:
#   TIINGO_API_KEY=
#   EODHD_API_KEY=
#   POLYGON_API_KEY=
